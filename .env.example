# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_…). Safe to ship to the browser: Row Level
# Security still applies, through the `anon` role. Replaces the retired anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses Row Level Security — never expose this to the browser.
# Secret key (sb_secret_…). Replaces the retired service_role key.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Stripe — Dashboard → Developers → API keys
# Prefer a restricted key (rk_test_…, rk_live_…): Customers, Checkout Sessions
# and Billing Portal Sessions at Write, Subscriptions at Read, everything else
# None. A secret key (sk_…) still works but can do anything in the account.
STRIPE_SECRET_KEY=sk_test_xxx
# Optional. Which prices onboarding offers comes from Stripe: every active
# recurring price (with an active product) is listed automatically, so adding a
# plan is a Dashboard change rather than a deploy. Set this comma-separated
# allowlist only when the account also keeps retired prices active for existing
# customers and they should stay off the picker.
STRIPE_PLAN_PRICE_IDS=
# Output of `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# One secret per endpoint: a deployed environment uses the secret shown on its
# own endpoint in the Dashboard, never this one.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public origin used for OAuth, email-link and Stripe return URLs when the
# incoming request has no proxy headers (for example, during local scripts).
# Leave it as localhost for development. On a Vercel deployment a local origin is
# ignored (and logged) in favour of VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL,
# so a stale value here cannot send confirmation links to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
